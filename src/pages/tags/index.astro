---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const ideas = await getCollection('ideas');

import { tagArMap, countryTags, countryFlagMap, countryEnMap } from '../../lib/tagAr';

// Map tag counts
const tagCountMap: Record<string, number> = {};
ideas.forEach((idea) => {
  idea.data.tags.forEach((tag) => {
    tagCountMap[tag] = (tagCountMap[tag] || 0) + 1;
  });
});

const toEntry = ([tag, count]: [string, number]) => ({
  tag,
  count,
  ar: tagArMap[tag] || tag,
});

// Countries get their own section + shape — never mixed into the sector cloud.
const countryEntries = Object.entries(tagCountMap)
  .filter(([tag]) => countryTags.has(tag))
  .map(toEntry)
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));

const sectorEntries = Object.entries(tagCountMap)
  .filter(([tag]) => !countryTags.has(tag))
  .map(toEntry)
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));

const countrySparkTotal = countryEntries.reduce((n, e) => n + e.count, 0);
---

<Base
  title="Explore 🧭 — Banana Nebula"
  description="Browse startup playbooks by country, sector, tech, and business models."
  activePath="/tags"
>
  <div style="margin: var(--space-8) 0 var(--space-16);">
    <!-- Tag Header -->
    <div style="margin-bottom: var(--space-8);">
      <div class="hero-tag-kicker">
        <span>🧭</span>
        <span>Explore the Library</span>
      </div>
      <h1 style="font-size: var(--type-display-xl); margin-bottom: var(--space-2);">
        Explore
      </h1>
      <p style="font-size: 1.125rem;">
        Pick a country to browse its startups, or a market sector to filter playbooks and lessons.
      </p>
      <div class="explore-jump">
        <a class="btn btn-secondary" href="#countries">🌍 Countries</a>
        <a class="btn btn-violet" href="#sectors">🏷️ Sectors</a>
      </div>
    </div>

    <!-- Countries: passport-style cards, not sticker pills -->
    <div class="country-head" id="countries">
      <h2 class="country-title">🌍 Browse by Country</h2>
      <span class="country-total">
        {countryEntries.length} COUNTRIES · {countrySparkTotal} SPARKS
      </span>
    </div>
    <p class="country-sub">
      Start from home turf — every spark filed under its country's flag.
    </p>
    <div class="country-panel">
      <ul class="country-grid" aria-label="Countries with idea counts">
        {countryEntries.map(({ tag, count, ar }, idx) => {
          // One uniform accent for all country cards: the ribbon/wash carry no
          // per-country meaning, so they share a single highlight (amber).
          const accent = {
            wash: 'var(--surface-1)',
            bar: 'var(--color-amber-500)',
          };
          const tilt = idx % 2 === 0 ? '-0.6deg' : '0.6deg';
          return (
            <li>
              <a
                class="country-card"
                rel="prefetch"
                href={`/tags/${tag}`}
                style={`--cc-wash: ${accent.wash}; --cc-bar: ${accent.bar}; --cc-tilt: ${tilt};`}
              >
                <span class="country-card-top">
                  <span class="country-flag" aria-hidden="true">
                    {countryFlagMap[tag] || '🌍'}
                  </span>
                  <span class="country-count">
                    {count} {count === 1 ? 'spark' : 'sparks'}
                  </span>
                </span>
                <span class="country-en">{countryEnMap[tag] || tag}</span>
                <span class="country-ar" lang="ar">{ar}</span>
                <span class="country-foot">
                  <span class="country-slug">#{tag}</span>
                  <span class="country-go" aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Sectors & Themes: funky sticker tag cloud -->
    <h2 id="sectors" style="font-size: 1.375rem; margin-bottom: var(--space-4);">
      🏷 Sectors & Themes
    </h2>
    <div
      style="
        background-color: var(--surface-2);
        border: 3px solid var(--border-dark);
        border-radius: var(--shape-xl);
        padding: var(--space-8) var(--space-6);
        box-shadow: var(--elevation-3);
      "
    >
      <ul
        class="chips"
        aria-label="All tags with idea counts"
        style="gap: var(--space-3); justify-content: flex-start;"
      >
        {sectorEntries.map(({ tag, count, ar }, idx) => {
          const rotations = [-2, 1.5, -1, 2.5, -1.5, 2];
          const rot = rotations[idx % rotations.length];
          const isHeavy = count >= 3;

          return (
            <li>
              <a
                class="chip"
                rel="prefetch"
                href={`/tags/${tag}`}
                style={`
                  transform: rotate(${rot}deg);
                  font-size: ${isHeavy ? '1rem' : '0.875rem'};
                  padding: ${isHeavy ? '8px 16px' : '6px 14px'};
                  background-color: ${
                    // Only evidence-backed hues: unicorn/failure match the
                    // idea-card status colors; everything else is lime
                    // (the tags role). Density is encoded by size (isHeavy),
                    // not by extra hues.
                    tag === 'unicorn'
                      ? 'var(--color-violet-100)'
                      : tag === 'failure'
                      ? 'var(--color-fuchsia-100)'
                      : 'var(--color-lime-100)'
                  };
                `}
              >
                <span>#{tag}</span>
                {ar && ar !== tag && (
                  <span style="font-family: var(--font-arabic); font-size: 0.8125rem; font-weight: 800; color: var(--text-secondary); margin-left: 4px;">
                    · {ar}
                  </span>
                )}
                <span
                  style="
                    margin-left: 6px;
                    padding: 2px 7px;
                    background-color: var(--surface-3);
                    border: 1px solid var(--border-dark);
                    border-radius: var(--shape-pill);
                    font-size: 0.75rem;
                    font-weight: 800;
                  "
                >
                  {count}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Quick Return -->
    <div style="margin-top: var(--space-10); display: flex; gap: var(--space-3);">
      <a class="btn btn-secondary" href="/#sparks" rel="prefetch">
        ← All Sparks
      </a>
      <a class="btn btn-violet" href="/random" rel="prefetch">
        🎲 Random Spark
      </a>
    </div>
  </div>
</Base>

<style>
  /* -- Country section: passport cards on a dotted panel ---------------- */
  .country-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .country-title {
    font-size: var(--type-h1);
  }

  .country-total {
    font-family: var(--font-mono);
    font-size: var(--type-mono-sm);
    font-weight: 700;
    color: var(--text-secondary);
    background-color: var(--surface-1);
    border: 2px solid var(--border-dark);
    border-radius: var(--shape-pill);
    padding: 4px 12px;
    box-shadow: var(--elevation-1);
    white-space: nowrap;
  }

  .country-sub {
    font-size: var(--type-body-lg);
    margin-bottom: var(--space-5);
  }

  /* Jump buttons under the Explore header */
  .explore-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  /* Anchor offset so the sticky nav never covers a jumped-to section */
  #countries,
  #sectors {
    scroll-margin-top: 110px;
  }

  .country-panel {
    background-color: var(--surface-2);
    background-image: radial-gradient(var(--border-default) 1.2px, transparent 1.2px);
    background-size: 18px 18px;
    border: 3px solid var(--border-dark);
    border-radius: var(--shape-xl);
    padding: var(--space-8) var(--space-6);
    box-shadow: var(--elevation-3);
    margin-bottom: var(--space-10);
  }

  .country-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .country-grid > li {
    min-width: 0;
  }

  .country-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    height: 100%;
    min-width: 0;
    background-color: var(--surface-3);
    border: 3px solid var(--border-dark);
    border-radius: var(--shape-lg);
    box-shadow: var(--elevation-2);
    padding: var(--space-5) var(--space-5) var(--space-4);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transform: rotate(var(--cc-tilt));
    transition:
      transform 150ms var(--ease-spring-quick),
      box-shadow 150ms var(--ease-spring-quick);
  }

  .country-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 8px;
    background-color: var(--cc-bar);
  }

  .country-card:hover {
    transform: rotate(0deg) translate(-2px, -3px);
    box-shadow: 8px 8px 0 var(--border-dark);
  }

  .country-card:focus-visible {
    outline: 3px solid var(--color-violet-500);
    outline-offset: 3px;
  }

  .country-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .country-flag {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    font-size: 1.8rem;
    line-height: 1;
    background-color: var(--cc-wash);
    border: 2.5px solid var(--border-dark);
    border-radius: 18px 8px 18px 8px;
    box-shadow: var(--elevation-1);
  }

  .country-count {
    font-family: var(--font-mono);
    font-size: var(--type-mono-sm);
    font-weight: 700;
    color: var(--text-secondary);
    background-color: var(--surface-1);
    border: 2px solid var(--border-dark);
    border-radius: var(--shape-pill);
    padding: 3px 10px;
    white-space: nowrap;
  }

  .country-en {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.375rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text-primary);
    overflow-wrap: break-word;
  }

  .country-ar {
    font-family: var(--font-arabic);
    font-weight: 800;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .country-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 2px dashed var(--border-default);
  }

  .country-slug {
    font-family: var(--font-mono);
    font-size: var(--type-mono-sm);
    font-weight: 700;
    color: var(--text-muted);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .country-go {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--cc-wash);
    border: 2px solid var(--border-dark);
    font-weight: 800;
    color: var(--text-primary);
    transition: transform 150ms var(--ease-spring-quick);
  }

  .country-card:hover .country-go {
    transform: translateX(3px);
  }

  @media (max-width: 560px) {
    .country-panel {
      padding: var(--space-5) var(--space-4);
    }

    .country-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .country-card {
      padding: var(--space-4) var(--space-4) var(--space-3);
      /* No tilt in the tight 2-up grid: rotated corners poked past the panel. */
      transform: none;
    }

    .country-card-top {
      gap: var(--space-2);
    }

    .country-flag {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      font-size: 1.3rem;
    }

    .country-count {
      font-size: 0.6875rem;
      padding: 2px 8px;
    }

    .country-en {
      font-size: 1.0625rem;
    }

    .country-ar {
      font-size: 1rem;
    }
  }
</style>
