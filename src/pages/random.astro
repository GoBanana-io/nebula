---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { countryTags, countryFlagMap } from '../lib/tagAr';

const ideas = await getCollection('ideas');
const allTags = new Set(ideas.flatMap((i) => i.data.tags || []));
const sparksData = ideas.map((idea) => {
  const tags = idea.data.tags || [];
  const sector = idea.data.sector || '';
  const countryTag =
    tags.find((t) => countryTags.has(t)) || (idea.data.country || '').toLowerCase();
  return {
    slug: idea.id.replace(/\.md$/, ''),
    title: idea.data.title,
    summary: idea.data.summary,
    summaryAr: idea.data.summaryAr || '',
    sector,
    stage: idea.data.stage || '',
    valuation: idea.data.valuation || '',
    amountRaised: idea.data.amountRaised || '',
    status: idea.data.status || 'operating',
    country: idea.data.country || '',
    countryFlag: countryFlagMap[countryTag] || '',
    countryHref: allTags.has(countryTag) ? `/tags/${countryTag}` : '',
    tags: tags.filter((t) => !countryTags.has(t) && t !== sector).slice(0, 3),
    whyItWorked: idea.data.whyItWorked || idea.data.coreProblem || '',
    isFailure: idea.data.status === 'closed' || idea.data.status === 'failed' || idea.data.tags.includes('failure'),
    isUnicorn: idea.data.tags.includes('unicorn'),
    isIdea: idea.data.status === 'idea',
  };
});

const initialIndex = Math.floor(Math.random() * sparksData.length);
const initialSpark = sparksData[initialIndex];
---

<Base
  title="Spark Roulette 🎲 — Nebula"
  description="Spin the startup roulette and get your next spark in seconds."
  activePath="/random"
>
  <section style="margin: var(--space-8) 0 var(--space-16);">
    <!-- Roulette Header -->
    <div style="text-align: center; max-width: 680px; margin: 0 auto var(--space-8);">
      <div class="hero-tag-kicker" style="margin-bottom: var(--space-3);">
        <span>🎰</span>
        <span>Instant Serendipity</span>
        <span>✦</span>
        <span>{sparksData.length} Ready Sparks</span>
      </div>
      <h1 style="font-size: var(--type-display-xl); margin-bottom: var(--space-2);">
        Spark Roulette
      </h1>
      <p style="margin: 0 auto; font-size: 1.125rem;">
        Spin the wheel. Get one pure spark. Steal the playbook.
      </p>
    </div>

    <!-- The Slot Machine Stage -->
    <div
      id="roulette-box"
      class="roulette-stage"
      style="
        max-width: 840px;
        margin: 0 auto;
        background-color: var(--surface-2);
        border: 3.5px solid var(--border-dark);
        border-radius: var(--shape-xl);
        box-shadow: var(--elevation-3);
        padding: var(--space-8) var(--space-6);
        position: relative;
        overflow: hidden;
      "
    >
      <!-- Live Display Card Preview -->
      <div
        id="spark-display"
        style="
          background-color: var(--surface-1);
          border: 2.5px solid var(--border-dark);
          border-radius: var(--shape-leaf);
          padding: var(--space-6);
          box-shadow: var(--elevation-2);
          margin-bottom: var(--space-6);
          transition: transform 150ms var(--ease-spring-bouncy), opacity 150ms ease;
        "
      >
        <!-- Origin + Tags -->
        <div id="spark-meta" style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; border-bottom: 1.5px dashed var(--border-dark); padding-bottom: var(--space-3); margin-bottom: var(--space-4);">
          <a class="chip chip-stage" id="spark-country" href={initialSpark.countryHref || undefined} rel="prefetch">
            {(initialSpark.countryFlag ? `${initialSpark.countryFlag} ` : '') + (initialSpark.country || 'Somewhere')}
          </a>
          <span id="spark-tags" style="display: contents;">
            {initialSpark.tags.map((tag) => (
              <a class="chip" href={`/tags/${tag}`} rel="prefetch">#{tag}</a>
            ))}
          </span>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3); flex-wrap: wrap; gap: var(--space-2);">
          <span class="chip chip-sector" id="spark-sector">
            {initialSpark.sector || 'Startup'}
          </span>
          <span class="card-kpi-pill" id="spark-kpi">
            {initialSpark.valuation && initialSpark.valuation !== 'MISSING'
              ? `Val: ${initialSpark.valuation}`
              : initialSpark.amountRaised
              ? `Raised: ${initialSpark.amountRaised}`
              : 'Active Spark'}
          </span>
        </div>

        <h2 id="spark-title" style="font-size: clamp(1.5rem, 3.5vw, 2.25rem); margin-bottom: var(--space-3); line-height: 1.15;">
          {initialSpark.title}
        </h2>

        <!-- Bilingual Body (Content) -->
        <div class="roulette-grid" style="display: grid; gap: var(--space-4); margin-bottom: var(--space-4);">
          <div class="lead-box-en" style="background-color: var(--surface-2); border: 1.5px solid var(--border-dark); border-radius: var(--shape-sm); padding: var(--space-4);">
            <p id="spark-summary" class="roulette-lede-en" style="font-size: 1.25rem; font-weight: 600; line-height: 1.5; color: var(--text-primary); margin: 0;">
              {initialSpark.summary}
            </p>
          </div>

          <div class="lead-box-ar" style="background-color: oklch(95% 0.02 65); border: 1.5px solid var(--border-dark); border-radius: var(--shape-sm); padding: var(--space-4); direction: rtl;">
            <p id="spark-summary-ar" class="roulette-lede-ar" style="font-family: var(--font-arabic); font-size: 1.375rem; font-weight: 800; color: var(--text-primary); margin: 0; line-height: 1.7;">
              {initialSpark.summaryAr}
            </p>
          </div>
        </div>

      </div>

      <!-- Action Buttons: Spin leads center-stage, rest support below -->
      <div class="roulette-actions" style="display: flex; justify-content: center; gap: var(--space-3); flex-wrap: wrap;">
        <button class="btn btn-primary btn-lg" id="btn-spin" type="button">
          🎰 Spin the Wheel
        </button>
        <div class="roulette-actions-sub">
          <a class="btn btn-secondary btn-lg" id="btn-open" rel="prefetch" href={`/idea/${initialSpark.slug}`}>
            Full Story ➔
          </a>
        </div>
      </div>
    </div>

    <!-- Quick Return Link -->
    <div style="text-align: center; margin-top: var(--space-10);">
      <a class="btn btn-secondary" href="/#sparks" rel="prefetch">
        ← Back to All Sparks
      </a>
    </div>
  </section>

<style>
  .roulette-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .roulette-actions {
    flex-direction: column;
    align-items: center;
  }

  #btn-spin {
    min-height: 60px;
    padding: 14px 44px;
    font-size: 1.125rem;
  }

  .roulette-actions-sub {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 640px) {
    /* Tighter stage, thumb-sized stacked actions, single-column body */
    .roulette-stage {
      padding: var(--space-5) var(--space-4);
    }

    .roulette-lede-en {
      font-size: 1.125rem;
    }

    .roulette-lede-ar {
      font-size: 1.1875rem;
    }

    .roulette-grid {
      grid-template-columns: 1fr;
    }

    .roulette-actions {
      flex-direction: column;
      align-items: stretch;
    }

    #btn-spin {
      width: 100%;
    }

    .roulette-actions-sub {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .roulette-actions .btn {
      width: 100%;
      min-height: 52px;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #spark-display {
      transition: none;
    }
  }
</style>

  <!-- Interactive Slot Script -->
  <script define:vars={{ sparksData, initialIndex }}>
    function initRoulette() {
      const stage = document.getElementById('roulette-box');
      if (!stage || stage.dataset.bnBound) return;
      stage.dataset.bnBound = '1';

      const allSparks = sparksData;
      let currentIndex = initialIndex;

    const btnSpin = document.getElementById('btn-spin');
    const btnOpen = document.getElementById('btn-open');
    const displayCard = document.getElementById('spark-display');
    const titleEl = document.getElementById('spark-title');
    const summaryEl = document.getElementById('spark-summary');
    const summaryArEl = document.getElementById('spark-summary-ar');
    const sectorEl = document.getElementById('spark-sector');
    const kpiEl = document.getElementById('spark-kpi');
    const countryEl = document.getElementById('spark-country');
    const tagsEl = document.getElementById('spark-tags');

    function renderMeta(item) {
      if (countryEl) {
        countryEl.textContent = `${item.countryFlag ? `${item.countryFlag} ` : ''}${item.country || 'Somewhere'}`;
        if (item.countryHref) countryEl.setAttribute('href', item.countryHref);
        else countryEl.removeAttribute('href');
      }
      if (tagsEl) {
        tagsEl.innerHTML = '';
        for (const t of item.tags || []) {
          const a = document.createElement('a');
          a.className = 'chip';
          a.textContent = `#${t}`;
          a.setAttribute('href', `/tags/${t}`);
          a.setAttribute('rel', 'prefetch');
          tagsEl.appendChild(a);
        }
      }
    }

    let isSpinning = false;

    btnSpin?.addEventListener('click', () => {
      if (isSpinning) return;
      isSpinning = true;
      btnSpin.disabled = true;
      btnSpin.textContent = '🎲 Rolling...';

      // Freeze the stage window so rolling text can't resize the card.
      const lockedH = displayCard.offsetHeight;
      displayCard.style.minHeight = `${lockedH}px`;
      displayCard.style.maxHeight = `${lockedH}px`;
      displayCard.style.overflow = 'hidden';

      let rolls = 0;
      const totalRolls = 16;
      let intervalSpeed = 60;

      function step() {
        currentIndex = Math.floor(Math.random() * allSparks.length);
        const item = allSparks[currentIndex];

        displayCard.style.transform = `scale(0.97) rotate(${Math.sin(rolls) * 2}deg)`;

        titleEl.textContent = item.title;
        summaryEl.textContent = item.summary;
        summaryArEl.textContent = item.summaryAr || item.summary;
        sectorEl.textContent = item.sector || 'Startup';
        renderMeta(item);
        kpiEl.textContent =
          item.valuation && item.valuation !== 'MISSING'
            ? `Val: ${item.valuation}`
            : item.amountRaised
            ? `Raised: ${item.amountRaised}`
            : 'Active Spark';

        btnOpen.setAttribute('href', `/idea/${item.slug}`);

        rolls++;
        if (rolls < totalRolls) {
          intervalSpeed += 14;
          setTimeout(step, intervalSpeed);
        } else {
          // Release the window onto the locked spark, then settle.
          displayCard.style.minHeight = '';
          displayCard.style.maxHeight = '';
          displayCard.style.overflow = '';
          displayCard.style.transform = 'scale(1.02) rotate(0deg)';
          setTimeout(() => {
            displayCard.style.transform = 'scale(1) rotate(0deg)';
          }, 180);

          btnSpin.textContent = '🎰 Spin Again';
          btnSpin.disabled = false;
          isSpinning = false;
        }
      }

      step();
    });

    }

    // First paint plus every client-side navigation (View Transitions).
    document.addEventListener('astro:page-load', initRoulette);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRoulette);
    } else {
      initRoulette();
    }
  </script>
</Base>
